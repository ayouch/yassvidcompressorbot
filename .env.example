# Token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# api_id / api_hash from https://my.telegram.org -> API development tools
# (required by the self-hosted Bot API server)
TELEGRAM_API_ID=000000
TELEGRAM_API_HASH=your_api_hash

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone (not recommended for a public VPS).
ALLOWED_USER_IDS=

# Optional: how many videos to compress at once (default 1).
MAX_CONCURRENT_JOBS=1
